<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net9.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <AssemblyName>MultiplayerColors</AssemblyName>
    <RootNamespace>MultiplayerColors</RootNamespace>
    <!-- The game loads this DLL into its own AssemblyLoadContext; it must not drag copies of the
         game's own assemblies along. Every Reference below is <Private>false</Private>. -->
    <EnableDynamicLoading>false</EnableDynamicLoading>
    <GenerateDocumentationFile>false</GenerateDocumentationFile>
    <!-- The default glob would sweep in tests/ as well, since the test project lives under this one. -->
    <EnableDefaultCompileItems>false</EnableDefaultCompileItems>
  </PropertyGroup>

  <ItemGroup>
    <Compile Include="src/**/*.cs" />
  </ItemGroup>

  <!-- Reference the game's own assemblies. Compiling against the exact DLLs the game will load at
       runtime removes any chance of a GodotSharp / sts2 version skew. This is deliberately NOT a
       Godot.NET.Sdk project: the mod ships no scenes and no .pck, so it needs no Godot project, no
       source generators, and no export step - just GodotSharp for the Color/CanvasItem types. -->
  <ItemGroup Condition="Exists('$(Sts2DataDir)')">
    <Reference Include="0Harmony">
      <HintPath>$(Sts2DataDir)/0Harmony.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="sts2">
      <HintPath>$(Sts2DataDir)/sts2.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="GodotSharp">
      <HintPath>$(Sts2DataDir)/GodotSharp.dll</HintPath>
      <Private>false</Private>
    </Reference>
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Krafs.Publicizer" Version="2.3.0" />
    <!-- Several art nodes keep their sprite/texture child in a private field (NHandImage._textureRect,
         NMultiplayerPlayerState._characterIcon, NRemoteTargetingIndicator._line, ...). Publicizing
         sts2 lets the patches reach them without reflection. -->
    <Publicize Include="sts2" />
  </ItemGroup>

  <Target Name="CheckDependencyPaths" BeforeTargets="Build">
    <Error
      Condition="!Exists('$(Sts2DataDir)')"
      Text="Slay the Spire 2 data directory not found at '$(Sts2DataDir)'. Override Sts2Path or Sts2DataDir (see Sts2PathDiscovery.props)." />
  </Target>

  <!-- NOTE: this project deliberately does NOT deploy into the game's local mods/ folder. This mod is
       distributed via the Steam Workshop only, and a local copy silently SHADOWS the Workshop one — the
       game logs "loaded both via Steam and local mods directory. Disabling the Steam workshop version",
       so you end up testing a build nobody else has. `build` leaves the DLL in $(OutputPath); to get it
       in game, publish it: scripts/publish-workshop.sh. The former CopyToModsFolderOnBuild target was
       removed for this reason, matching the sibling the-apprentice-mod repo. -->

  <!-- Belt and braces: fail the build if a stale local copy is sitting there shadowing the Workshop one. -->
  <Target Name="WarnOnLocalModCopy" BeforeTargets="Build" Condition="Exists('$(ModsPath)$(AssemblyName)')">
    <Error Text="A local copy of $(AssemblyName) exists at $(ModsPath)$(AssemblyName) and will shadow the Steam Workshop version. This mod is Workshop-only — remove that folder before building." />
  </Target>
</Project>
